<odoo>
<record id="helpdesk_root_cause_view_search" model="ir.ui.view">
    <field name="name">helpdesk_root_cause - search</field>
    <field name="model">helpdesk_root_cause</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="helpdesk_root_cause_view_tree" model="ir.ui.view">
    <field name="name">helpdesk_root_cause - tree</field>
    <field name="model">helpdesk_root_cause</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="helpdesk_root_cause_view_form" model="ir.ui.view">
    <field name="name">helpdesk_root_cause - form</field>
    <field name="model">helpdesk_root_cause</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="helpdesk_root_cause_action" model="ir.actions.act_window">
    <field name="name">Root Causes</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">helpdesk_root_cause</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="helpdesk_root_cause_menu"
        name="Root Causes"
        parent="menu_helpdesk_ticket_configuration"
        action="helpdesk_root_cause_action"
        groups="helpdesk_root_cause_group"
        sequence="140"
    />

</odoo>
